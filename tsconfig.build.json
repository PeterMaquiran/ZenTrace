{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "sourceMap": true,
    // Node ESM consumers need explicit file extensions; NodeNext makes tsc
    // reject the extensionless specifiers that a bundler would have tolerated.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": ["src/*"]
    },
    // 👇 only app-safe types
    "types": []
  },
  "include": ["src"],
  "exclude": ["cypress", "**/*.test.ts", "**/*.spec.ts"]
}
